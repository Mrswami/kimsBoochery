# ══════════════════════════════════════════════════════════════
# KIMBOOCHERLY — Environment Variables
# ══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual API keys
# NEVER commit .env to version control
# ══════════════════════════════════════════════════════════════

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=kimboocherly.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=kimboocherly
VITE_FIREBASE_STORAGE_BUCKET=kimboocherly.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# External API Keys
VITE_GOOGLE_MAPS_KEY=your_google_maps_key_here
VITE_OPENAI_API_KEY=your_openai_api_key_here
VITE_STRIPE_PUBLIC_KEY=your_stripe_public_key_here
VITE_ANALYTICS_KEY=your_analytics_key_here
VITE_GITHUB_TOKEN=your_github_token_here
